# Required in production (when MYHUB_COOKIE_SECURE=true or MYHUB_ENV!=development,
# the app refuses to boot without these)
MYHUB_PASSWORD=change-me-to-a-strong-password
MYHUB_SECRET_KEY=change-me-to-a-long-random-string
MYHUB_ENV=production
# Optional integrations (features degrade gracefully if unset)
MFDS_API_KEY=
OPENAI_API_KEY=
# LLM provider: leave OPENAI_BASE_URL empty for real OpenAI, or point it at any
# OpenAI-compatible endpoint. For NVIDIA NIM (build.nvidia.com):
#   OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
#   OPENAI_API_KEY=<your nvidia nvapi- key>
#   OPENAI_MODEL_STRONG=meta/llama-3.1-8b-instruct   # analysis (~8s, fast + clean enough on free tier)
#   OPENAI_MODEL_MINI=meta/llama-3.1-8b-instruct     # nutrient estimate (~9s)
# Free-tier model notes (benchmarked on a real key): 8b returns a valid Korean
# report in seconds and is the best free-tier pick. Bigger models are worse
# here — meta/llama-3.3-70b-instruct runs >4 min (too slow), and the mid-size
# ones (nvidia/llama-3.3-nemotron-super-49b-v1) leak non-Korean text. Free-tier
# analysis is lighter and can occasionally slip a foreign word; for deep, snappy,
# reliable reports use a paid/dedicated NIM endpoint (or OpenAI).
# (default model ids are OpenAI's gpt-5/gpt-5-mini, which do NOT exist on NVIDIA —
#  you MUST set the model ids above when using a non-OpenAI base URL)
# Pick OPENAI_MODEL_STRONG for speed: big 70B models are heavily queued on the
# NVIDIA free tier (analysis can take minutes). A fast mid-size instruct model is
# strongly preferred — benchmark on your own key to choose.
OPENAI_BASE_URL=
# Per-LLM-call timeout in seconds (default 60, sized for the fast 8b model). A
# hung/queued provider fails fast instead of tying up the request; raise it if
# you switch to a slower/bigger model.
OPENAI_TIMEOUT=60
# Deploy note: MYHUB_COOKIE_SECURE=true requires the app to sit behind an HTTPS reverse proxy
# (the cookie is Secure-flagged; browsers won't send it over plain HTTP).
MYHUB_COOKIE_SECURE=false
# Web push VAPID keys (generated once — see Phase 3 plan Task 4 Step 10).
# On Fly.io, secrets are env vars only (no baked-in file), so set
# VAPID_PRIVATE_KEY to the raw base64 private key string, not a .pem path.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Only used by Caddyfile/docker-compose.yml on the Oracle free-tier deploy
# path (docs/deploy-oracle-free.md) — the app itself never reads this.
MYHUB_DOMAIN=
